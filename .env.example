HOST=localhost
PORT=3080
APP_MODE=production
APP_DATA_DIR=storage
APP_LOG_LEVEL=info
APP_LOG_FORMAT=structured
APP_LOG_TRANSPORT=file
APP_SECRET_KEY=_PUT_SECURE_ENCRYPTION_KEY_FOR_APP_HERE_
AUTH_PRIVATE_KEY=__YOUR_JWT_PRIVATE_KEY_HERE__
AUTH_PUBLIC_KEY=__YOUR_JWT_PUBLIC_KEY_HERE__
AUTH_SECRET_KEY=__SECRET_KEY_FOR_JWT_HMAC_ALGORITHM_SIGNING__
# Lifetimes are seconds.
# Internal bearer JWT the SPA sends on RPC calls (refresh stays cookie-only).
AUTH_ACCESS_TOKEN_EXPIRY=600
# Session issued with "remember me".
AUTH_SESSION_LIFETIME=2592000
# Session issued without "remember me"; must not exceed AUTH_SESSION_LIFETIME.
AUTH_SESSION_SHORT_LIFETIME=43200
AUTH_GITHUB_CLIENT_ID=
AUTH_GITHUB_CLIENT_SECRET=
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
DATABASE_URL=postgresql://postgres:securedb@localhost:5432/postgres?sslmode=disable
MAILER_FROM_EMAIL="mailer@example.com"
MAILER_FROM_NAME="MyApplication"
MAILER_SMTP_HOST=localhost
MAILER_SMTP_PORT=1025
MAILER_SMTP_USERNAME=maileruser1
MAILER_SMTP_PASSWORD=mailerpass1
MAILER_SMTP_SECURE=false

# OIDC relying-party lifetimes, in seconds. A client's own access and
# refresh durations override the two token defaults.
OIDC_ACCESS_TOKEN_EXPIRY=3600
OIDC_REFRESH_TOKEN_EXPIRY=2592000
OIDC_AUTHORIZATION_CODE_EXPIRY=120
OIDC_INTERACTION_EXPIRY=900
OIDC_DEVICE_CODE_EXPIRY=900
OIDC_PAR_EXPIRY=60
PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_S3_ASSETS_URL=http://localhost:9180
PUBLIC_VERSION_CHECK_URL=https://api.github.com/repos/riipandi/tango/releases/latest
PUBLIC_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3080
QUEUE_WORKERS=4
QUEUE_RELEASE_AFTER=300
QUEUE_CLEANUP_INTERVAL=21600
STORAGE_DATA_DIR=storage/files
STORAGE_MAX_UPLOAD_SIZE=5242880
STORAGE_S3_ACCESS_KEY_ID=s3admin
STORAGE_S3_BUCKET_DEFAULT=devbucket
STORAGE_S3_ENDPOINT_URL=http://localhost:9100
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_S3_PATH_PREFIX=null
STORAGE_S3_REGION=auto
STORAGE_S3_SECRET_ACCESS_KEY=s3passw0rd
STORAGE_S3_SIGNED_URL_EXPIRES=3600
